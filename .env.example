# Discord Botのトークン（Discord Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=

# ApplicationのClient ID（Discord Developer Portal > General Information > Application ID）
CLIENT_ID=

# コマンドを特定のギルドだけに即時反映したい場合に設定（開発中はこちらを推奨）
# 未設定の場合はグローバルコマンドとして登録します（反映まで最大1時間程度かかります）
GUILD_ID=

# デフォルトのタイムゾーン（reminders.dbのtimezone列のデフォルト値としても使用）
TZ=Asia/Tokyo
